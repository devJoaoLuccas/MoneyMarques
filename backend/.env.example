# ─── Aplicacao ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origem permitida no CORS e usada nos links de e-mail (convite, verificacao, redefinicao)
FRONTEND_URL=http://localhost:5173

# ─── Banco de dados (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/moneymarques?schema=public

# ─── Seguranca ───────────────────────────────────────────────
# Assina cookies de sessao
COOKIE_SECRET=
# Pepper para hash de tokens (sessao, convite, redefinicao, codigos MFA)
TOKEN_HASH_PEPPER=
# Chave AES-256 (32 bytes em hex = 64 caracteres) que criptografa o segredo TOTP
MFA_ENCRYPTION_KEY=
MFA_ISSUER="Money Marques"
# Chave do HMAC-SHA-256 que protege e-mails no banco (identificador de busca/unicidade)
EMAIL_HMAC_KEY=
# Chave AES-256 (32 bytes em hex = 64 caracteres) da copia cifrada do e-mail (envio/exibicao)
EMAIL_ENCRYPTION_KEY=
# Chave AES-256 (32 bytes em hex = 64 caracteres) da copia cifrada do codigo de convite ativo (distinta das demais)
INVITE_CODE_ENCRYPTION_KEY=

# Duracao das sessoes
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30
# Validade dos tokens
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
FAMILY_INVITE_TTL_DAYS=7

# ─── E-mail (SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
# true = TLS implicito (padrao na porta 465); vazio = decide pela porta (587 usa STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Money Marques <no-reply@exemplo.com>"
